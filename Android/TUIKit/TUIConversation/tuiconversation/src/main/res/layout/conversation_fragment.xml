<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/conversation_page_bg">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.tencent.qcloud.tuikit.tuiconversation.classicui.widget.ConversationLayout
            android:id="@+id/conversation_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:id="@+id/lv_notif"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="true"
            android:background="#FACCC5"
            android:layout_height="40dp">
            <TextView
                android:paddingLeft="8dp"
                android:gravity="center_vertical"
                android:textColor="#F23315"
                android:layout_weight="1"
                android:text="打开通知，可及时接收到聊天消息"
                android:id="@+id/tv_open"

                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <TextView


                android:layout_marginRight="16dp"
                android:id="@+id/btn_set"
                android:layout_width="50dp"
                android:textSize="16dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:text="设置"
                android:clickable="false"
                android:background="@drawable/bg_notif_set"
                android:layout_height="30dp"/>

        </LinearLayout>
    </RelativeLayout>



</LinearLayout>
